    "/sf/category/overview": {
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "Category Overview",
        "description": "Get category-level totals/dynamics for an already-created reportId.",
        "operationId": "getCategoryOverview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryOverviewRequest"
              }
