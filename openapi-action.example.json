        ],
        "summary": "Category Products",
        "description": "Get products from a category report, with common analytical filters and sorting.",
        "operationId": "getCategoryProducts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryProductsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
