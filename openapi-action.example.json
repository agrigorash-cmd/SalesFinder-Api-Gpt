        "summary": "Category Report",
        "description": "Create a SalesFinder category report. Response contains reportId; report may need time to build.",
        "operationId": "createCategoryReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryReportRequest"
              }
