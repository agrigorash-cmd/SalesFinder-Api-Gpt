              "application/json": {
                "schema": {
                  "title": "Response Getproductkeywords"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/sf/category/search": {
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "Category Search",
        "description": "Find SalesFinder category IDs by marketplace, period and optional category name.",
        "operationId": "searchCategories",
