        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/sf/product/keywords": {
      "post": {
        "tags": [
          "products"
        ],
        "summary": "Product Keywords",
        "description": "Search queries/keywords and SKU positions for the selected period.",
        "operationId": "getProductKeywords",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequest"
              }
            }
          },
