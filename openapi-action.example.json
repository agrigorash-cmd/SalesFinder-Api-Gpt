            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/sf/product/days": {
      "post": {
        "tags": [
          "products"
        ],
        "summary": "Product Days",
        "description": "Daily dynamics: sales, revenue, stock, price, reviews and rating.",
        "operationId": "getProductDailyMetrics",
        "requestBody": {
          "content": {
