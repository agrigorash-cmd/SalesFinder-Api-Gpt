# SalesFinder account with External API access
SALESFINDER_EMAIL=you@example.com
SALESFINDER_PASSWORD=change-me

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_API_KEY=replace-with-a-long-random-secret

SALESFINDER_BASE_URL=https://api.salesfinder.ru
SALESFINDER_API_VERSION=2025_09

# SalesFinder docs recommend no more than one request every 5 seconds/account
SF_MIN_INTERVAL_SECONDS=5.1
HTTP_TIMEOUT_SECONDS=40
